; Per-user Foolship installer.
; The installer never requests elevation and never removes %LOCALAPPDATA%\Foolship\data.
; CI passes /DSourceDir and /DMyAppVersion. A missing version is a build error.
#ifndef SourceDir
  #define SourceDir "release\Foolship"
#endif
#ifndef MyAppVersion
  #define MyAppVersion "0.0.0"
#endif
; Generated by scripts/build_desktop.py from agent_harness.brand, so run that
; before compiling the installer by hand.
#ifndef IconFile
  #define IconFile "..\..\build\brand\foolship.ico"
#endif

#define AppName "Foolship"
#define AppPublisher "Foolship"
#define AppId "{{B9E6D97E-8B31-4A8E-9B5D-7A6E7B4D2C10}"
#define AppExeName "Foolship.exe"

[Setup]
AppId={#AppId}
AppName={#AppName}
AppVersion={#MyAppVersion}
AppPublisher={#AppPublisher}
; Per-user install: any directory the user can write to is allowed, and the
; wizard asks for it. Choosing a protected directory fails with a permission
; error instead of silently installing elsewhere.
DefaultDirName={localappdata}\Foolship\app
DefaultGroupName={#AppName}
DisableProgramGroupPage=yes
PrivilegesRequired=lowest
ArchitecturesInstallIn64BitMode=x64compatible
ArchitecturesAllowed=x64compatible
OutputDir=..\..
OutputBaseFilename=Foolship-{#MyAppVersion}-windows-x64-setup
Compression=lzma2/max
SolidCompression=yes
WizardStyle=modern
SetupIconFile={#IconFile}
Uninstallable=yes
UninstallDisplayName={#AppName} {#MyAppVersion}
[Files]
Source: "{#SourceDir}\*"; DestDir: "{app}"; Flags: ignoreversion recursesubdirs createallsubdirs

[Icons]
Name: "{autoprograms}\{#AppName}"; Filename: "{app}\{#AppExeName}"
Name: "{autodesktop}\{#AppName}"; Filename: "{app}\{#AppExeName}"; Tasks: desktopicon

[Tasks]
Name: "desktopicon"; Description: "创建桌面快捷方式"; GroupDescription: "附加快捷方式："

[Run]
Filename: "{app}\{#AppExeName}"; Description: "启动 {#AppName}"; Flags: nowait postinstall skipifsilent

[Code]
procedure CurUninstallStepChanged(CurUninstallStep: TUninstallStep);
var
  DataDir, RuntimeDir: String;
begin
  if CurUninstallStep <> usPostUninstall then
    exit;
  // A silent uninstall must never block on a dialog.
  if UninstallSilent then
    exit;
  DataDir := ExpandConstant('{localappdata}\Foolship\data');
  RuntimeDir := ExpandConstant('{localappdata}\Foolship\service-runtime');
  if not DirExists(DataDir) then
    exit;
  if MsgBox('是否同时删除本机数据？' + #13#10 + #13#10 +
       '包含：账户与登录状态、团队数据库（项目/消息/任务）、接收设置、MCP 授权。' + #13#10 +
       '不删除：' + DataDir + ' 之外的文件，以及 Documents\Foolship 里收到的文件。' + #13#10 + #13#10 +
       '选择“是”会永久删除这些数据，且无法恢复。',
       mbConfirmation, MB_YESNO or MB_DEFBUTTON2) <> IDYES then
    exit;
  DelTree(DataDir, True, True, True);
  DelTree(RuntimeDir, True, True, True);
end;
